<?xml version="1.0" encoding="utf-8"?>
<!--
  Purrdoro's mascot: an original, minimal line-art cat built from a handful of
  XAML paths (round head, triangular ears, dot eyes, tiny mouth, two paws).
  All geometry is in a 100 x 88 design box and scaled by the Viewbox, so the
  control resizes cleanly at any size or display scale.

  Expressions cross-fade the named parts below (eyes, mouths, "z z", sparkles).
  The code-behind sets the opacity of EVERY named part on each mood change, using
  CatExpression.For(mood) from Purrdoro.Core, so the previous expression is always
  hidden and parts can never stack:
    Content     - waiting to start: round dot eyes
    Focused     - focus running: attentive eyes with a tiny highlight
    Sleepy      - paused: closed eyes and a small "z z"
    Happy       - on a break: relaxed ^ ^ eyes
    Celebrating - session finished: ^ ^ eyes, open smile and two sparkles
-->
<UserControl
    x:Class="Purrdoro.Controls.CatMascot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False"
    AutomationProperties.AccessibilityView="Raw">

    <Grid x:Name="RootGrid" IsHitTestVisible="False">

        <Viewbox Stretch="Uniform">
            <Grid Width="100" Height="88">

                <!-- Whiskers -->
                <Path
                    Data="M5,52 L15,54 M5,59 L15,58.5 M95,52 L85,54 M95,59 L85,58.5"
                    Stroke="{ThemeResource PurrCatInkBrush}"
                    StrokeThickness="1.4"
                    StrokeStartLineCap="Round"
                    StrokeEndLineCap="Round"
                    Opacity="0.55" />

                <!-- Ears (drawn before the head so the head hides their bases) -->
                <Path
                    Data="M21,40 L25,11 L45,25 Z M79,40 L75,11 L55,25 Z"
                    Fill="{ThemeResource PurrCatFaceBrush}"
                    Stroke="{ThemeResource PurrCatInkBrush}"
                    StrokeThickness="2.4"
                    StrokeLineJoin="Round" />

                <!-- Head -->
                <Path
                    Data="M16,50 A34,28 0 1,1 84,50 A34,28 0 1,1 16,50 Z"
                    Fill="{ThemeResource PurrCatFaceBrush}"
                    Stroke="{ThemeResource PurrCatInkBrush}"
                    StrokeThickness="2.4" />

                <!-- Cheeks -->
                <Path
                    Data="M23.5,59 A5,3.2 0 1,1 33.5,59 A5,3.2 0 1,1 23.5,59 Z M66.5,59 A5,3.2 0 1,1 76.5,59 A5,3.2 0 1,1 66.5,59 Z"
                    Fill="{ThemeResource PurrCatBlushBrush}" />

                <!-- Eyes: content (default) -->
                <Path
                    x:Name="EyesContent"
                    Data="M34.8,47.5 A3.2,3.6 0 1,1 41.2,47.5 A3.2,3.6 0 1,1 34.8,47.5 Z M58.8,47.5 A3.2,3.6 0 1,1 65.2,47.5 A3.2,3.6 0 1,1 58.8,47.5 Z"
                    Fill="{ThemeResource PurrCatInkBrush}">
                </Path>

                <!-- Eyes: focused (slightly taller, attentive) -->
                <Path
                    x:Name="EyesFocused"
                    Data="M34.6,47 A3.4,4.4 0 1,1 41.4,47 A3.4,4.4 0 1,1 34.6,47 Z M58.6,47 A3.4,4.4 0 1,1 65.4,47 A3.4,4.4 0 1,1 58.6,47 Z"
                    Fill="{ThemeResource PurrCatInkBrush}"
                    Opacity="0">
                </Path>
                <Path
                    x:Name="EyeHighlights"
                    Data="M38.2,45.2 A1.1,1.1 0 1,1 40.4,45.2 A1.1,1.1 0 1,1 38.2,45.2 Z M62.2,45.2 A1.1,1.1 0 1,1 64.4,45.2 A1.1,1.1 0 1,1 62.2,45.2 Z"
                    Fill="{ThemeResource PurrCatFaceBrush}"
                    Opacity="0">
                </Path>

                <!-- Eyes: closed / sleepy -->
                <Path
                    x:Name="EyesClosed"
                    Data="M33.5,48 Q38,52 42.5,48 M57.5,48 Q62,52 66.5,48"
                    Stroke="{ThemeResource PurrCatInkBrush}"
                    StrokeThickness="2.2"
                    StrokeStartLineCap="Round"
                    StrokeEndLineCap="Round"
                    Opacity="0">
                </Path>

                <!-- Eyes: happy ^ ^ -->
                <Path
                    x:Name="EyesHappy"
                    Data="M33.5,50 Q38,44.5 42.5,50 M57.5,50 Q62,44.5 66.5,50"
                    Stroke="{ThemeResource PurrCatInkBrush}"
                    StrokeThickness="2.2"
                    StrokeStartLineCap="Round"
                    StrokeEndLineCap="Round"
                    Opacity="0">
                </Path>

                <!-- Mouth: small "w" -->
                <Path
                    x:Name="MouthSmall"
                    Data="M45,55.5 Q47.5,58.8 50,55.8 Q52.5,58.8 55,55.5"
                    Stroke="{ThemeResource PurrCatInkBrush}"
                    StrokeThickness="1.8"
                    StrokeStartLineCap="Round"
                    StrokeEndLineCap="Round"
                    StrokeLineJoin="Round">
                </Path>

                <!-- Mouth: open smile -->
                <Path
                    x:Name="MouthOpen"
                    Data="M45.5,55.5 Q50,64 54.5,55.5 Z"
                    Fill="{ThemeResource PurrCatMouthBrush}"
                    Stroke="{ThemeResource PurrCatInkBrush}"
                    StrokeThickness="1.6"
                    StrokeLineJoin="Round"
                    Opacity="0">
                </Path>

                <!-- Paws resting on the timer below -->
                <Path
                    Data="M30,80 A7,5 0 1,1 44,80 A7,5 0 1,1 30,80 Z M56,80 A7,5 0 1,1 70,80 A7,5 0 1,1 56,80 Z"
                    Fill="{ThemeResource PurrCatFaceBrush}"
                    Stroke="{ThemeResource PurrCatInkBrush}"
                    StrokeThickness="2.2" />

                <!-- Sleepy "z z" -->
                <Path
                    x:Name="SleepyZs"
                    Data="M80,15 L86,15 L80,21 L86,21 M89,6 L93,6 L89,10 L93,10"
                    Stroke="{ThemeResource PurrCatInkBrush}"
                    StrokeThickness="1.5"
                    StrokeStartLineCap="Round"
                    StrokeEndLineCap="Round"
                    StrokeLineJoin="Round"
                    Opacity="0">
                </Path>

                <!-- Celebration sparkles -->
                <Path
                    x:Name="Sparkles"
                    Data="M88,15 Q89,22.5 96,23.5 Q89,24.5 88,32 Q87,24.5 80,23.5 Q87,22.5 88,15 Z M11,13 Q11.6,18.4 16,19 Q11.6,19.6 11,25 Q10.4,19.6 6,19 Q10.4,18.4 11,13 Z"
                    Fill="{ThemeResource PurrSparkleBrush}"
                    Opacity="0">
                </Path>
            </Grid>
        </Viewbox>
    </Grid>
</UserControl>
