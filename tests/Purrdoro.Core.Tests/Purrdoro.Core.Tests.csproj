<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Dependency-free test runner for Purrdoro.Core. It is a plain console app
    (no xUnit/MSTest packages), so it runs anywhere the .NET 10 SDK is installed.
    See README.md for the command. Exit code 0 means every test passed.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Purrdoro.Core.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Purrdoro.Core\Purrdoro.Core.csproj" />
  </ItemGroup>

</Project>
